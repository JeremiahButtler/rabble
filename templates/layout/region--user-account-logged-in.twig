{#
/**
 * @file
 * Rabble's theme override to display the breadcrumb region.
 *
 * Available variables:
 * - content: The content for this region, typically blocks.
 * - attributes: HTML attributes for the region <div>.
 * - region: The name of the region variable as defined in the theme's
 *   .info.yml file.
 *
 * @see template_preprocess_region()
 */
#}

{%
  set classes = [
    'region',
    'region--' ~ region|clean_class,
    'grid-full',
    'layout--pass--content-medium',
  ]
%}

{% if content %}
	<div id="user-account-contents" class="column user-account-contents">
		<aside class="section" role="complementary">
			{{ drupal_region('user_account_logged_in') }}		  
			{{ drupal_region('user_account_logged_in_left') }}		  
			{{ drupal_region('user_account_logged_in_right') }}		  
		</aside>
	 </div>
  <div{{ attributes.addClass(classes) }}>
    <div class="content-container user-profile-contents">
      {{ content }}
	</div>
  </div>
{% endif %}
